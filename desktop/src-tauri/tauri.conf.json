{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Application-Pal",
  "version": "0.1.0",
  "identifier": "com.medvesek.d2603",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Application-Pal",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/app-pal-backend"],
    "resources": {
      "../../frontend/dist/": "frontend/",
      "../../backend/drizzle-pglite/": "migrations/",
      "resources/pglite/": "pglite/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
