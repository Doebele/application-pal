{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Application-Pal",
  "version": "0.1.0",
  "identifier": "com.medvesek.d2603",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Application-Pal",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "externalBin": [
      "binaries/app-pal-backend"
    ],
    "resources": {
      "../../frontend/dist/": "frontend/",
      "../../backend/drizzle-pglite/": "migrations/",
      "resources/pglite/": "pglite/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "sidecar.entitlements",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English",
          "French"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNUNBRDJDNTYwQkNCMEEKUldRS3l3dFdMSzFjcmlWejhJSVpjVlFMWmNndWsrMFdnbC8rWWlIcFpNWjZpc0UvZENZNzBRNWIK",
      "endpoints": [
        "https://github.com/Doebele/application-pal/releases/download/desktop-updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
